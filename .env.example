# Ẹkúmidáyọ̀mí backend local-development configuration.
# Copy this file to .env. Never place production credentials in either file.
# These URLs are for an API process running on the host machine; Compose overrides
# dependency hostnames with its service names.

# Application
EKUMIDAYOMI_APP_ENV=development
EKUMIDAYOMI_APP_NAME=Ẹkúmidáyọ̀mí API
EKUMIDAYOMI_DEBUG=false
EKUMIDAYOMI_API_PREFIX=/api/v1
EKUMIDAYOMI_SECRET_KEY=development-only-change-me

# HTTP policy. Pydantic Settings requires JSON arrays for list values.
EKUMIDAYOMI_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
EKUMIDAYOMI_CORS_ORIGINS=["http://localhost:3000"]
EKUMIDAYOMI_SECURE_COOKIES=false

# PostgreSQL. Development and test data must use different databases.
EKUMIDAYOMI_DATABASE_URL=postgresql+asyncpg://ekumidayomi:development-only@localhost:5432/ekumidayomi
EKUMIDAYOMI_TEST_DATABASE_URL=postgresql+asyncpg://ekumidayomi:test-only@localhost:5433/ekumidayomi_test
EKUMIDAYOMI_DATABASE_POOL_SIZE=10
EKUMIDAYOMI_DATABASE_MAX_OVERFLOW=10
EKUMIDAYOMI_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Redis. Redis is not the source of truth for durable business data.
EKUMIDAYOMI_REDIS_URL=redis://localhost:6379/0
EKUMIDAYOMI_REDIS_CONNECT_TIMEOUT_SECONDS=2
EKUMIDAYOMI_REDIS_OPERATION_TIMEOUT_SECONDS=2

# Startup dependency validation
EKUMIDAYOMI_CHECK_DEPENDENCIES_ON_STARTUP=true
